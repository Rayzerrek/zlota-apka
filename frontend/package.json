{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm run build && wrangler pages dev ./dist",
    "deploy": "pnpm run build && wrangler pages deploy ./dist --project-name=zlota-apka",
    "fmt": "oxfmt -c ../.oxfmtrc.json",
    "fmt:check": "oxfmt -c ../.oxfmtrc.json --check",
    "lint": "oxlint -c ../.oxlintrc.json",
    "lint:fix": "oxlint -c ../.oxlintrc.json --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/kumo": "^1.19.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.168.25",
    "better-auth": "^1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "i18next": "^26.0.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "react-i18next": "^17.0.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.85.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxlint -c ../.oxlintrc.json",
      "oxfmt -c ../.oxfmtrc.json"
    ],
    "*.{json, jsonc, css}": [
      "oxfmt"
    ]
  }
}
