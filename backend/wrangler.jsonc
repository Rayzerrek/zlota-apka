{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zlota-apka",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",

  "triggers": {
    "crons": ["0 7 * * *"],
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
