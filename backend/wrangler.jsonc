{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zlota-apka",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",
  "assets": {
    "directory": "./dist/client",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
