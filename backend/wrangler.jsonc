{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recurs-app",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",

  "triggers": {
    "crons": ["0 7 * * *"],
  },

  "vars": {
    "FRONTEND_URL": "https://recurs.app,http://localhost:5173",
    "BETTER_AUTH_URL": "https://api.recurs.app",
    "DEMO_GUEST_ID": "demo-guest",
    "EMAIL_FROM": "Recurs <hello@recurs.app>",
  },

  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
