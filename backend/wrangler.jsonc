{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zlota-apka",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",

  "triggers": {
    "crons": ["0 7 * * *"],
  },

  "vars": {
    "FRONTEND_URL": "https://zlota-apka.pages.dev,http://localhost:5173",
    "BETTER_AUTH_URL": "https://zlota-apka.rayserrek.workers.dev",
    "DEMO_GUEST_ID": "demo-guest",
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
