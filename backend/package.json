{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy -c dist/zlota_apka/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "vite": "^8.0.9",
    "vite-ssr-components": "^0.5.2",
    "wrangler": "^4.83.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,jsonc,css}": [
      "oxfmt"
    ]
  }
}
